{
  "name": "@shipscope/shared",
  "version": "0.6.5",
  "description": "Domain types, business rules and demo data shared by the API and the dashboard.",
  "private": true,
  "type": "module",
  "exports": {
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./rules": {
      "source": "./src/rules.ts",
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./seed": {
      "source": "./src/seed.ts",
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
