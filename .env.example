# Backend (NestJS) environment variables. Copy to .env and adjust.
# npm run start / start:dev / start:debug / start:prod load ./.env when it exists
# (node --env-file-if-exists); variables exported in the shell also work.
# Frontend variables live in frontend/.env.example.

# HTTP port of the API (routes are served under /api).
PORT=3000

# Bearer token the services send to read flags: GET /api/sdk/flags with "Authorization: Bearer <SDK_TOKEN>".
# Required: without it the endpoint answers 503. Use a long random value, e.g. `openssl rand -hex 32`.
SDK_TOKEN=

# PostgreSQL holding flags, services, the audit log and settings (required). Matches the docker compose defaults
# below: `docker compose up -d db`, then `npm run db:deploy` (migrations) and optionally `npm run db:seed`.
DATABASE_URL=postgresql://shipscope:shipscope@localhost:5432/shipscope_flags

# Database for the backend tests; they truncate it, so never point it at real data. docker compose creates it.
TEST_DATABASE_URL=postgresql://shipscope:shipscope@localhost:5432/shipscope_flags_test

# Default Slack-compatible webhook for prod change notifications.
# Only used until notifications are saved in Settings.
NOTIFY_WEBHOOK_URL=

# Webhooks must be https and must not point to a private or local address. Optionally limit them to these hosts
# (comma-separated); a host listed here may also be internal, e.g. a self-hosted chat server.
NOTIFY_WEBHOOK_HOSTS=

# --- docker compose (docker-compose.yml) -------------------------------------------------------------------------
# Local-only defaults; set real values before running the stack anywhere shared.
POSTGRES_USER=shipscope
POSTGRES_PASSWORD=shipscope
POSTGRES_DB=shipscope_flags
POSTGRES_PORT=5432
WEB_PORT=8080
# docker compose uses this SDK token when SDK_TOKEN above is empty. For local use only.
# (Services in the stack read flags with: curl -H "Authorization: Bearer local-sdk-token" ...)
# Load the demo flags into an empty database when the stack starts (the migrate service).
SEED_DEMO_DATA=true
