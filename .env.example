# Backend (NestJS) environment variables. Copy to .env and adjust.
# npm run start / start:dev / start:debug / start:prod load ./.env when it exists
# (node --env-file-if-exists); variables exported in the shell also work.
# Frontend variables live in frontend/.env.example.

# HTTP port of the API (routes are served under /api).
PORT=3000

# --- Sign-in (OpenID Connect) — required ----------------------------------------------------------------------------
# The dashboard and the management API need a signed-in user; the API runs the sign-in with any OIDC provider (Keycloak,
# Entra ID, Okta, Google, …) and keeps a server-side session in an HttpOnly cookie. Register a confidential client
# with the redirect URI <APP_URL>/api/auth/callback and the post-logout redirect URI <APP_URL>/.
# The values below match the local Keycloak from docker compose (`docker compose up -d keycloak`, users a.kowalska /
# m.chen / j.novak, password "shipscope") with the dashboard's dev server on port 5173.

# Public address of the dashboard (where users open it).
APP_URL=http://localhost:5173
# The provider's issuer, exactly as its metadata (/.well-known/openid-configuration) names it.
OIDC_ISSUER=http://localhost:8180/realms/shipscope
OIDC_CLIENT_ID=shipscope-flags
OIDC_CLIENT_SECRET=shipscope-dev-secret
# Optional: where the API reads the provider's metadata when it reaches the provider at another address than browsers do
# (e.g. inside docker compose). The metadata must still name OIDC_ISSUER.
OIDC_DISCOVERY_URL=
# The provider must use https; true allows http, for a local test provider only.
OIDC_ALLOW_HTTP=true
# Scopes asked for at sign-in. Default "openid profile email".
OIDC_SCOPES=
# Roles: the ID token claim that lists the user's roles or groups (a dotted path such as realm_access.roles reaches
# into objects; default "roles"), and which of its values make a user an Admin or an Editor (comma-separated; defaults
# shipscope-admin and shipscope-editor). Everyone else the provider lets in is a Viewer; to keep out users without any
# of the roles, list the viewer ones in OIDC_VIEWER_ROLES.
OIDC_ROLES_CLAIM=
OIDC_ADMIN_ROLES=
OIDC_EDITOR_ROLES=
OIDC_VIEWER_ROLES=
# Hours a session lasts before the user signs in again (default 12). The role is read at sign-in.
SESSION_TTL_HOURS=

# Services read flags (GET /api/v1/sdk/flags, docs/sdk-api.md) with their own credential, issued in the dashboard
# (Services). Deprecated: a shared token every service may send instead, kept while services move to their own
# credentials. Leave empty unless some service still needs it; if set, use a long random value (`openssl rand -hex 32`).
SDK_TOKEN=

# PostgreSQL holding flags, services, the audit log and settings (required). Matches the docker compose defaults
# below: `docker compose up -d db`, then `npm run db:deploy` (migrations) and optionally `npm run db:seed`.
DATABASE_URL=postgresql://shipscope:shipscope@localhost:5432/shipscope_flags

# Database for the backend tests; they truncate it, so never point it at real data. docker compose creates it.
TEST_DATABASE_URL=postgresql://shipscope:shipscope@localhost:5432/shipscope_flags_test

# Default Slack-compatible webhook for prod change notifications.
# Only used until notifications are saved in Settings.
NOTIFY_WEBHOOK_URL=

# Webhooks must be https and must not point to a private or local address. Optionally limit them to these hosts
# (comma-separated); a host listed here may also be internal, e.g. a self-hosted chat server.
NOTIFY_WEBHOOK_HOSTS=

# Days to keep audit log entries; once a day the API deletes older ones and notes how many in the log.
# Default 730 (two years); 0 keeps everything.
AUDIT_RETENTION_DAYS=

# Requests per minute per client address and route; over it the API answers 429 with Retry-After. 0 = no limit.
# Defaults: 300 for the management API, 600 for the consumer endpoint (services polling it). Counted in memory.
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_SDK_PER_MINUTE=

# Behind a reverse proxy, which proxies to trust for the client address (X-Forwarded-For): a hop count such as 1, or
# addresses/subnets such as "loopback, uniquelocal". Empty = the API is reached directly. docker compose sets uniquelocal.
TRUST_PROXY=

# --- docker compose (docker-compose.yml) -------------------------------------------------------------------------
# Local-only defaults; set real values before running the stack anywhere shared.
POSTGRES_USER=shipscope
POSTGRES_PASSWORD=shipscope
POSTGRES_DB=shipscope_flags
POSTGRES_PORT=5432
WEB_PORT=8080
# Load the demo flags into an empty database when the stack starts (the migrate service).
SEED_DEMO_DATA=true
# The local Keycloak (test identity provider): its port on localhost and its admin console password (user "admin").
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_PASSWORD=admin
