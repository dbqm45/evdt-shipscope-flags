{
  "name": "shipscope-flags",
  "version": "0.2.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "nest start --exec \"node --env-file-if-exists=.env\"",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start:debug": "nest start --debug --watch --exec \"node --env-file-if-exists=.env\"",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "sync:shared": "node scripts/sync-shared.mjs",
    "prebuild": "npm run sync:shared",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env dist/db/load-state.js --seed --if-empty",
    "db:import": "node --env-file-if-exists=.env dist/db/load-state.js --file",
    "release": "node scripts/release.mjs",
    "lint:commit": "node scripts/check-commit-message.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
